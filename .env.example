# Backend (copy to backend/.env or export in your shell)
OLIVE_DATA_SOURCE=sample          # sample | agridata
OLIVE_COUNTRIES=ES,IT,GR,PT
OLIVE_FIRST_MARKETING_YEAR=2014
OLIVE_CACHE_TTL=21600             # seconds
OLIVE_CORS_ORIGINS=http://localhost:5173

# Frontend (frontend/.env.local). Leave empty to read the static JSON instead of the API.
VITE_API_URL=http://localhost:8000
